# vmakefile for Amiga Python LoadSeg plugins (VBCC)
# Invoked from Source/ (no -C): make -f Modules/plugin/vmakefile
#
# Pattern from FastForward (Docs/PLUGIN_GUIDE.md, plugins/*_extheader.c):
#   - first object is the module head (security + ID)
#   - -nostdlib: no C startup / no libc in the plugin
#   - host vtable provides Python C API, AmiTCP sockets, and libc helpers
#   - do NOT link -lposix (a second SocketBase would break AmiTCP fds)
#   - pyamiga_minirt.o supplies SysBase/abort/exit/__aprintf for -lmieee

CC=vc
CONFIG=+aos68k_posix
# No -stack-check / no small-data: FastForward DATA=FARONLY equivalent.
CFLAGS=-c -O1 -D_AMIGA -DHAVE_CONFIG_H -DHAVE_POSIXLIB -D__USE_NEW_TIMEVAL__ \
	-D__NO_NETINCLUDE_TIMEVAL -DPYAMIGA_PLUGIN_BUILD \
	-IModules/plugin -Ivbcc:PosixLib/include -IInclude -IModules \
	-Ivincludeos3: -Iinclude: -Inetinclude: -cpu=68020 -fpu=soft
SRCDIR=Modules/plugin
OUTDIR=lib/lib-dynload
MKDIR=MakeDir ALL

# socket_entry.o first = FastForward extheader link order.
SOCKET_OBJS=$(SRCDIR)/socket_entry.o \
	$(SRCDIR)/socketmodule_plugin.o \
	$(SRCDIR)/pyamiga_api.o \
	$(SRCDIR)/pyamiga_posix.o \
	$(SRCDIR)/pyamiga_libc.o \
	$(SRCDIR)/pyamiga_minirt.o

# Default _ssl backend is AmiTLS (BearSSL). Assign amitlsinclude: to the
# AmiTLS SDK Include_H directory (libraries/amitls.h, proto/amitls.h).
# AmiSSL (#ifndef PYAMIGA_USE_AMITLS in sslmodule.c): assign sslinclude: to
# AmiSSL SDK Developer/include, then select SSL_CFLAGS_AMISSL below.
# Delete sslmodule_plugin.o and _ssl.module before switching backends.
# Do not -I a host-side SDK path; the assign is the public include root.
#
# AmiSSL note: OpenSSL 3.6.x / AmiSSL 5 builds import and wrap, but the
# first SSL_connect dies in SSLERR (want=NOTHING, empty ERR) - see the
# BUG comment at SSL_connect in Modules/sslmodule.c. Production default
# stays AmiTLS until that handshake path is fixed.
SSL_CFLAGS_AMITLS=$(CFLAGS) -DPYAMIGA_USE_AMITLS -Iamitlsinclude:
SSL_CFLAGS_AMISSL=$(CFLAGS) -Isslinclude:
SSL_CFLAGS=$(SSL_CFLAGS_AMITLS)
#SSL_CFLAGS=$(SSL_CFLAGS_AMISSL)

SSL_OBJS=$(SRCDIR)/ssl_entry.o \
	$(SRCDIR)/sslmodule_plugin.o \
	$(SRCDIR)/pyamiga_api.o \
	$(SRCDIR)/pyamiga_posix.o \
	$(SRCDIR)/pyamiga_libc.o \
	$(SRCDIR)/pyamiga_minirt.o

all: $(OUTDIR)/_socket.module $(OUTDIR)/_ssl.module

$(OUTDIR)/_socket.module: $(SOCKET_OBJS)
	@$(MKDIR) $(OUTDIR)
	$(CC) $(CONFIG) -nostdlib -o $@ $(SOCKET_OBJS) -lamiga

$(OUTDIR)/_ssl.module: $(SSL_OBJS)
	@$(MKDIR) $(OUTDIR)
	$(CC) $(CONFIG) -nostdlib -o $@ $(SSL_OBJS) -lamiga

$(SRCDIR)/socket_entry.o: $(SRCDIR)/socket_entry.c Include/pyamiga_plugin.h \
		$(SRCDIR)/pyamiga_redir.h
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $(SRCDIR)/socket_entry.c

$(SRCDIR)/socketmodule_plugin.o: $(SRCDIR)/socketmodule_plugin.c \
		Modules/socketmodule.c Include/pyamiga_plugin.h \
		$(SRCDIR)/pyamiga_redir.h
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $(SRCDIR)/socketmodule_plugin.c

$(SRCDIR)/ssl_entry.o: $(SRCDIR)/ssl_entry.c Include/pyamiga_plugin.h \
		$(SRCDIR)/pyamiga_redir.h
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $(SRCDIR)/ssl_entry.c

$(SRCDIR)/sslmodule_plugin.o: $(SRCDIR)/sslmodule_plugin.c \
		Modules/sslmodule.c Modules/sslmodule_amitls.c \
		Include/pyamiga_plugin.h $(SRCDIR)/pyamiga_redir.h
	$(CC) $(CONFIG) $(SSL_CFLAGS) -o $@ $(SRCDIR)/sslmodule_plugin.c

$(SRCDIR)/pyamiga_api.o: $(SRCDIR)/pyamiga_api.c Include/pyamiga_plugin.h \
		$(SRCDIR)/pyamiga_redir.h
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $(SRCDIR)/pyamiga_api.c

$(SRCDIR)/pyamiga_posix.o: $(SRCDIR)/pyamiga_posix.c Include/pyamiga_plugin.h \
		$(SRCDIR)/pyamiga_redir.h
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $(SRCDIR)/pyamiga_posix.c

$(SRCDIR)/pyamiga_libc.o: $(SRCDIR)/pyamiga_libc.c Include/pyamiga_plugin.h \
		$(SRCDIR)/pyamiga_redir.h
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $(SRCDIR)/pyamiga_libc.c

$(SRCDIR)/pyamiga_minirt.o: $(SRCDIR)/pyamiga_minirt.c Include/pyamiga_plugin.h
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $(SRCDIR)/pyamiga_minirt.c

clean:
	-Delete $(SRCDIR)/socket_entry.o $(SRCDIR)/socketmodule_plugin.o \
		$(SRCDIR)/ssl_entry.o $(SRCDIR)/sslmodule_plugin.o \
		$(SRCDIR)/pyamiga_api.o $(SRCDIR)/pyamiga_posix.o \
		$(SRCDIR)/pyamiga_libc.o $(SRCDIR)/pyamiga_minirt.o \
		$(OUTDIR)/_socket.module $(OUTDIR)/_ssl.module

.PHONY: all clean
