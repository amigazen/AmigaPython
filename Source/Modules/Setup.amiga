# AmigaOS module configuration

# Core Amiga components
amiga amiga/amigamodule.c
amigapath amiga/amigapathmodule.c

# Network modules when compiled with AMITCP/Genesis — LoadSeg plugin, not linked
# socket socketmodule.c

# Standard modules that should work on Amiga
array arraymodule.c
math mathmodule.c
time timemodule.c
select selectmodule.c
binascii binascii.c
_codecs _codecsmodule.c
cStringIO cStringIO.c
cPickle cPickle.c
errno errnomodule.c
# posixmodule.c is not built — OS builtin is amiga (sys.modules['posix'] alias at runtime)
operator operator.c
_weakref _weakref.c
_struct _struct.c
zlib zlibmodule.c -lz 