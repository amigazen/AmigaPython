	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $< -lamiga

$(ODIR)/amiga_icon.o: $(SRCDIR)/amiga/amiga_icon.c
	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $< -lamiga

$(ODIR)/socketmodule.o: $(SRCDIR)/socketmodule.c Include/pyconfig.h
	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) -Inetinclude: -o $@ $< -lamiga

$(ODIR)/pwdmodule.o: $(SRCDIR)/pwdmodule.c
	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $<

$(ODIR)/grpmodule.o: $(SRCDIR)/grpmodule.c
	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) -o $@ $<

