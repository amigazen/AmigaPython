	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) -Inetinclude: -o $@ $<

$(ODIR)/pyexpat.o: $(SRCDIR)/pyexpat.c
	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) $(EXPAT_CFLAGS) -o $@ $<

$(ODIR)/xmlparse.o: $(EXPAT_DIR)/xmlparse.c
	@$(MKDIR) $(ODIR)
	$(CC) $(CONFIG) $(CFLAGS) $(EXPAT_CFLAGS) -o $@ $<

$(ODIR)/xmlrole.o: $(EXPAT_DIR)/xmlrole.c
	@$(MKDIR) $(ODIR)
